# Port 5433 is non-default: on the machine this was developed on, Postgres.app already owns the
# standard port 5432, so the brew-installed postgresql@16 used for local dev/tests was configured
# to listen on 5433 instead. If tests can't connect, run `pg_ctl -D /opt/homebrew/var/postgresql@16
# status` and check what's actually listening on 5432 vs 5433 (e.g. `lsof -iTCP -sTCP:LISTEN -P | grep postgres`),
# then adjust the port below to match your own setup. Copy this file to `.env` (git-ignored) to use it.
DATABASE_URL=postgresql://localhost:5433/vansh_dev
